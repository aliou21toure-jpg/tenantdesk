{
  "name": "tenantdesk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Multi-tenant invoicing SaaS API — auth, role-based permissions, PostgreSQL row-level security",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "node dist/src/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "db:migrate:test": "tsx --env-file=.env.test scripts/migrate.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  },
  "engines": { "node": ">=22" }
}
